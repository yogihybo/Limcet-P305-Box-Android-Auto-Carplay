# Binary images — not built from source, stored externally or LFS
kernel/zImage
env/mtd3_env_prado_firmware_dump.bin
display/mtd4_arkdata_prado_firmware_dump.bin

# Rootfs build outputs (generated by build_rootfs.sh)
Prado firmware reconstructed/mtd6_rootfs/rootfs.ubifs
Prado firmware reconstructed/mtd6_rootfs/rootfs.img
Prado firmware reconstructed/mtd6_rootfs/ubi.cfg

# Userdata build outputs (generated by build_userdata.sh)
Prado firmware reconstructed/mtd7_userdata/userdata.ubifs
Prado firmware reconstructed/mtd7_userdata/userdata.img

# U-Boot env build output (generated by build_update.sh's env build step)
env/uboot-env.bin

# Rootfs runtime pseudo-directories (empty mountpoints, no content to track)
Prado firmware reconstructed/mtd6_rootfs/rootfs/proc/
Prado firmware reconstructed/mtd6_rootfs/rootfs/sys/
Prado firmware reconstructed/mtd6_rootfs/rootfs/dev/
Prado firmware reconstructed/mtd6_rootfs/rootfs/tmp/

# SD update output (generated by legacy/generate_update.sh — not for git)
sd_update/output/

# Bootable SD image output (generated by build_bootable_sdcard.sh — not for git)
sd_bootable/
# Pre-move (repo-root) location of the same output — kept ignored so any
# leftover local copy from before the sd_bootable/ move doesn't get staged.
/sd_boot.img

# uboot_sdboot.bin is NOT ignored — it's the ARK1680 BSP source-compiled
# U-Boot binary that patch_uboot.py and build_bootable_sdcard.sh use as
# input (has a real reserved env buffer, unlike the raw NAND-dumped
# uboot.bin), and is tracked so the SD-boot build works out of the box.
