<StyleSheet>
<Screen_400x240 fontsize="12">
    <WidgetStyleSheet>QWidget{background-color:transparent;border:none;outline:0;color:#fff;font-size:auto;background-repeat:repeat-no;background-position:center;}</WidgetStyleSheet>
