#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t ramfs -n none /tmp
mkdir -p /media
mount -t ramfs -n none /media
mkdir -p /var
mount -t ramfs -n none /var
mkdir -p /var/run/
mkdir -p /var/lib/lockdown
sync
/sbin/mdev -s

# Set each MUSB controller's operating mode (usb1's CarPlay wired/WiFi
# role, and a fast-path for USB-stick test boots) -- see
# docs/WIRELESS_AND_INIT.md sec 7 and the comments in this script for
# why. Needs /proc and /sys mounted (above), nothing else -- run this
# as early as possible so it can override the kernel's own in-progress
# OTG negotiation (which starts automatically at driver init, well
# before rcS runs) sooner rather than later.
/etc/switchotg.sh

# libarkcmn.so/libarkadapt.so (vendor 2D-blit compositor + CarPlay adapter)
# hardcode /tmp/dev/memalloc as their physically-contiguous buffer-allocator
# device -- stock creates it via etc/memalloc_load.sh's `insmod .../3.4.0/
# .../memalloc.ko` + mknod. That module path doesn't exist on this kernel,
# but it doesn't need to: CONFIG_ARK_MEMALLOC=y means memalloc is built
# directly into this kernel, and mdev -s above already created the real
# device at /dev/memalloc. Just point the path the vendor libs expect at
# the real one, so full-window/submenu GPU-composited rendering (which
# depends on this device) gets a valid buffer instead of silently failing
# open() -- see docs/DEVICE_TEST_CHECKLIST_2026-07-18.md section 1b (the
# "submenus go black" investigation).
mkdir -p /tmp/dev
ln -sf /dev/memalloc /tmp/dev/memalloc

touchdriver="/msnprofile/ark1680_ts"

if [ -e $touchdriver ]; then
        modprobe ark1680_ts 2>/dev/null || true  # 3.4.0 driver not built for 4.19.192 yet
        ln -s   /msnprofile/touch_ark1680_ts_export /tmp/touch_export
else
        modprobe gt9xx 2>/dev/null || true        # 3.4.0 driver not built for 4.19.192 yet
        ln -s /msnprofile/touch_gt9xx_export /tmp/touch_export
fi

#insmod  /lib/modules/3.4.0/kernel/drivers/input/misc/pwm-beeper.ko
#insmod  /lib/modules/3.4.0/galcore.ko registerMemBase=0xE0F00000 irqLine=32 contiguousSize=0x400000 physSize=0x80000000 powerManagement=0

# Mount userdata: ext4 p3 (SD or USB, whichever root actually came from)
# first, NAND UBI fallback, then yaffs2. ROOTDEV is derived from the
# kernel's own root= bootarg rather than hardcoded to /dev/mmcblk0p3, so
# the same rcS works for both bootmmc (root=/dev/mmcblk0pN) and bootusb
# (root=/dev/sdaN) without needing separate rootfs builds.
ROOTDEV=$(cat /proc/cmdline | sed -n 's/.*root=\([^ ]*\).*/\1/p')
USERDATADEV="${ROOTDEV%?}3"
if mount -o sync -t ext4 "$USERDATADEV" /data 2>/dev/null; then
	echo "userdata: ext4 ($USERDATADEV)"
	resetenv=$(fw_printenv factory_reset 2>/dev/null || echo "factory_reset=0")
	if [ "${resetenv##*=}" = "1" ]; then
		echo "==============Factory reset, reformat userdata!==========="
		umount /data
		mkfs.ext4 -O ^64bit,^metadata_csum -F "$USERDATADEV"
		mount -o sync -t ext4 "$USERDATADEV" /data
		fw_setenv factory_reset 0 2>/dev/null || true
	fi
else
	USERDATAFS=`cat /proc/mounts | grep ubifs`
	if [ "${USERDATAFS}" != "" ]; then
		mtd_partition=7
		resetenv=$(fw_printenv factory_reset 2>/dev/null || echo "factory_reset=0")
		if [ "${resetenv##*=}" = "1" ]; then
			echo "==============Factory reset, erase data partition!==========="
			flash_eraseall /dev/mtd$mtd_partition
			ubiattach /dev/ubi_ctrl -m $mtd_partition
			ubimkvol  /dev/ubi1 -N userdata -m 14
			ubidetach /dev/ubi_ctrl -m $mtd_partition -d 1
			fw_setenv factory_reset 0 2>/dev/null || true
		fi
		ubiattach /dev/ubi_ctrl -m $mtd_partition
		mount -o sync -t ubifs ubi1_0 /data
		if [ $? -eq 0 ]; then
			echo "userdata: NAND UBI"
		else
			sync; sleep 1
			mount -o sync -t ubifs ubi1_0 /data
			if [ $? -ne 0 ]; then
				echo "mount failed! then reformat the volume!"
				ubidetach /dev/ubi_ctrl -m $mtd_partition -d 1
				flash_eraseall /dev/mtd$mtd_partition
				ubiattach /dev/ubi_ctrl -m $mtd_partition
				ubimkvol  /dev/ubi1 -N userdata -m 14
				mount -o sync -t ubifs ubi1_0 /data
				sync
			fi
		fi
	else
		USERDATAFS=`cat /proc/mounts | grep yaffs2`
		if [ "${USERDATAFS}" != "" ]; then
			mount -t yaffs2 /dev/mtdblock6 /data/
		fi
	fi
fi
