    <ButtonStyleSheet>QPushButton{border-image:rgba(20, 20, 20, 185);border-radius:5;border:1px solid #555;color:#fff;background-position:center;background-repeat:repeat-no;}QPushButton:pressed, QPushButton::checked{background-color:qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgba(255, 114, 2, 255), stop: 0.33 rgba(255, 145, 2, 255), stop: 0.6 rgba(255, 197, 1, 255), stop: 1.0 rgba(255, 251, 0, 255))}</ButtonStyleSheet>
