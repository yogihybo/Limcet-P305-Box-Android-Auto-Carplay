# Shell/Python scripts must stay LF — CRLF breaks the shebang line and
# heredocs when these run on Linux (Debian/WSL), regardless of what
# line-ending setting a given contributor's git client uses.
*.sh text eol=lf
*.py text eol=lf

Prado[[:space:]]firmware[[:space:]]dump/mtd6_rootfs_raw/*.bin filter=lfs diff=lfs merge=lfs -text
Holden[[:space:]]firmware[[:space:]]update/rootfs.img filter=lfs diff=lfs merge=lfs -text
Prado[[:space:]]firmware[[:space:]]reconstructed/mtd6_rootfs/rootfs/etc/ssh/ssh_host_*_key -text
