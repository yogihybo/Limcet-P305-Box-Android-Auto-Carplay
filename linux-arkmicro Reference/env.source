#!/bin/bash

export SOURCE_PATH=$(cd `dirname $BASH_SOURCE`;pwd)
if [ -d ${SOURCE_PATH}/buildroot-external/toolchain/gcc-linaro-7.3.1-2018.05-x86_64_arm-linux-gnueabihf ]; then
export PATH=${SOURCE_PATH}/buildroot-external/toolchain/gcc-linaro-7.3.1-2018.05-x86_64_arm-linux-gnueabihf/bin:$PATH
else
export PATH=${SOURCE_PATH}/buildroot-external/toolchain/gcc-linaro-7.4.1-2019.02-x86_64_arm-linux-gnueabihf/bin:$PATH
fi
export CROSS_COMPILE=arm-linux-gnueabihf-
export ARCH=arm
