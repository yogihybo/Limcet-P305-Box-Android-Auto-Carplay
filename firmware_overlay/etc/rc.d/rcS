#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t ramfs -n none /tmp
mkdir -p /media
mount -t ramfs -n none /media
mkdir -p /var
mount -t ramfs -n none /var
mkdir -p /var/run/
mkdir -p /var/lib/lockdown
mkdir -p /var/log
sync
/sbin/mdev -s

# 2026-08-04: mdev -s above is a one-shot coldplug scan only -- it creates
# device nodes for what's already present at boot, then exits. Reacting to
# anything plugged in afterward needs a persistent listener. This kernel's
# legacy CONFIG_UEVENT_HELPER mechanism (auto-invoking a helper program on
# every hotplug uevent) is unset/compiled out, but that's not the only
# path: `mdev -df` listens directly on a netlink socket for kobject uevents
# (CONFIG_NET=y, confirmed on), a separate, more modern kernel mechanism
# that doesn't depend on CONFIG_UEVENT_HELPER at all.
#
# The busybox 1.30.1 build previously shipped here didn't have this
# option: CONFIG_FEATURE_MDEV_DAEMON doesn't exist as a Kconfig symbol
# until busybox 1.31+ (confirmed by grepping that version's own
# util-linux/mdev.c -- no daemon code path present at all, not just
# disabled). Rebuilt busybox from 1.33.0 -- same version this project's
# buildroot tree already uses elsewhere, defconfig enables the daemon
# feature by default.
#
# First rebuild attempt (dynamically linked against the host toolchain's
# glibc 2.36) booted straight into a kernel panic ("Attempted to kill
# init!", GLIBC_2.29/2.34 not found) -- the device's own libc is 2.27,
# far older than the host toolchain's. Swapping in the device's own
# libc-2.27.so at link time (the tools/hx170-test recipe) doesn't work
# for a whole program like busybox either: that old glibc's stat/fcntl
# family isn't ABI-compatible with code compiled against modern glibc
# headers (undefined stat64/lstat64/fcntl64 -- old glibc only exports
# the __xstat-style wrapper interface for those). Real fix: static
# linking (CONFIG_STATIC=y, no runtime libc dependency at all) plus the
# project's existing nss-stub treatment (see tools/nss-stub/README.md)
# for the small set of real glibc NSS/dlopen symbols busybox still
# references (getaddrinfo/gethostbyname/gethostbyaddr/getservbyname/
# getservbyport for ipcalc/netstat/inetd, plus dlopen defensively) --
# busybox's OWN getpwnam/getpwuid/getgrnam/getgrgid/etc are NOT wrapped,
# since CONFIG_USE_BB_PWD_GRP=y already makes busybox provide those
# itself without ever touching glibc's NSS machinery. See
# tools/nss-stub/nss_stub_busybox.c for the stub implementations, and
# project_usb_udisk_automount memory for the full build recipe
# (CONFIG_EXTRA_LDFLAGS must fold the wrap flags and stub .o into a
# single "-Wl,..." token, or busybox's own build system double-links it
# into an intermediate built-in.o and the final binary both).
#
# Verified via qemu-arm-static running the actual new binary: `mdev
# --help` lists real `-d`/`-f` daemon flags, applet list unchanged from
# the previous 1.30.1 build (396 vs 392 entries, normal version churn).
/sbin/mdev -df &

# 2026-08-02: low-latency socket polling, system-wide -- practical
# mitigation attempt for the long-running AA media audio stutter
# investigation (docs/AUDIO_SUBSYSTEM_INVESTIGATION.md), tried after
# live tracing (strace) proved too invasive on this hardware to safely
# gather more diagnostic data. Makes the kernel busy-poll for incoming
# socket data instead of relying purely on interrupt-driven wakeup,
# for every socket system-wide -- sink itself never opts in via
# setsockopt(SO_BUSY_POLL) (confirmed absent from its binary), so this
# is the only way to get this behavior without patching sink, which is
# a genuine, unmodified vendor binary. NOT a restoration of stock
# behavior -- CONFIG_NET_RX_BUSY_POLL (and these sysctls) didn't exist
# until Linux 3.11; stock runs Linux 3.4 and cannot have this
# mechanism, full stop. A deliberate deviation, not a stock match.
# Values are microseconds to busy-poll before falling back to normal
# interrupt-driven waiting; 50us is a commonly-used starting point for
# this class of low-latency tuning, not derived from anything specific
# to this hardware -- revisit if it doesn't help or if CPU usage rises
# noticeably (busy-polling trades CPU time for latency, real cost on a
# single-core system already suspected of contention).
sysctl -w net.core.busy_poll=50 >/dev/null 2>&1
sysctl -w net.core.busy_read=50 >/dev/null 2>&1

# REMOVED 2026-08-05 (see git history for the full removed block): RT
# throttling disable (kernel.sched_rt_runtime_us=-1), ksoftirqd/0
# real-time priority elevation, and TCP congestion control override
# (reno) -- three mitigations from the 2026-08-04 AA audio-stutter
# investigation, tested together and confirmed NOT sufficient on their
# own (see project_aa_audio_stutter_investigation memory). The actual
# fix landed 2026-08-05 at the kernel/driver level instead (DMA channel
# priority over eMMC, cyclic-DMA tasklet on HI softirq, a genuine
# vendor MUSB regression revert, and bypassing the generic
# dmaengine_pcm framework -- see linux-arkmicro commits 7e6d93657/
# 886e8b56c/c195cb9de/3ec51480d), which was hardware-confirmed and
# isolation-tested to be both necessary and sufficient without any of
# these userspace-side mitigations. Reverted to stock's actual
# defaults (no chrt, no RT-priority juggling, no congestion-control
# override) now that the real fix doesn't need them propping it up.
#
# 2026-08-04: actually activate ALSA's XRUN debug logging -- AA audio-
# stutter investigation. CONFIG_SND_PCM_XRUN_DEBUG=y (already enabled
# in this kernel's defconfig) only compiles IN the capability; it does
# NOT turn logging on by itself. The real switch is a per-substream
# runtime bitmask (sound/core/pcm_lib.c's `pstr->xrun_debug`) that has
# no default-value assignment anywhere in the kernel source -- it's
# zero-initialized memory, and the only way it ever becomes non-zero is
# by writing to a proc control file
# (sound/core/pcm.c:snd_pcm_xrun_debug_write(), registered as
# "xrun_debug" under each substream's own /proc/asound/cardN/pcmN[cp]/
# dir). An earlier test that relied on CONFIG_SND_PCM_XRUN_DEBUG alone
# found zero XRUN lines in dmesg despite audible stutter and sink's own
# `play:225` line (a disassembly-confirmed genuine ALSA EPIPE/XRUN
# recovery event) firing repeatedly -- that "clean negative" was almost
# certainly just this switch never having been flipped on, not real
# evidence against XRUN happening. `__snd_pcm_xrun()` (sound/core/
# pcm_lib.c) is confirmed the SOLE function anywhere in sound/core that
# transitions PCM state to SNDRV_PCM_STATE_XRUN, and its logging is
# unconditionally tied to that same transition once this bit is set --
# no other path can produce an XRUN without also logging it here.
#
# 1 = XRUN_DEBUG_BASIC (one line per XRUN, timestamped, matches
# CONFIG_SND_VERBOSE_PRINTK's format). card0/pcm0 is this board's only
# sound card/PCM device (ark1668-sdadc/sddac, confirmed single ALSA
# device throughout this project) -- p=playback, c=capture, both
# covered since either could underrun independently.
for f in /proc/asound/card0/pcm0p/xrun_debug /proc/asound/card0/pcm0c/xrun_debug; do
	[ -e "$f" ] && echo 1 > "$f" 2>/dev/null
done

# REMOVED 2026-08-05: the /proc/sched_debug RT-throttling poller this
# same file used to have here. Its only purpose was watching for
# recurrence of `kernel.sched_rt_runtime_us=-1` (RT throttle disable)
# not actually taking effect -- that sysctl and the RT-priority
# mitigations it was compensating for are both gone now (see the
# removed-mitigations comment near the top of this file), so there's
# nothing left for this poller to watch for. Also stops an unbounded,
# uncapped background file (/data/sched_debug_rt.log) from growing
# forever.

# Set each MUSB controller's operating mode (usb1's CarPlay wired/WiFi
# role, and a fast-path for USB-stick test boots) -- see
# docs/1.4_WIRELESS_AND_INIT.md sec 7 and the comments in this script for
# why. Needs /proc and /sys mounted (above), nothing else -- run this
# as early as possible so it can override the kernel's own in-progress
# OTG negotiation (which starts automatically at driver init, well
# before rcS runs) sooner rather than later.
/etc/switchotg.sh

# Feed the hardware watchdog (ark_wdt, /dev/watchdog) so a full kernel
# hang/lockup triggers a real reset instead of the unit sitting dead
# until someone power-cycles the vehicle. Previously present but
# dormant (no feed daemon existed in either stock's real rootfs or
# ours) -- also needed a kernel-side fix (linux-arkmicro's ark_wdt.c
# soft_noboot default 1 -> 0) since the driver's interrupt/soft mode
# silently never resets anything regardless of feeding, see that
# file's comment. busybox's own watchdog applet is already compiled in
# (firmware_overlay/busybox-applets.manifest); -t is the feed interval,
# -T must match the kernel driver's configured timeout
# (ARK_WATCHDOG_DEFAULT_TIME, drivers/watchdog/ark_wdt.c) -- 5s feed /
# 15s hardware timeout gives a 3x margin. /dev/watchdog is created
# automatically by devtmpfs (CONFIG_DEVTMPFS=y), no mdev rule needed.
watchdog -t 5 -T 15 /dev/watchdog

# Clear U-Boot's boot-attempt counter (see linux-arkmicro's
# ark1668_boot_cmds.c do_bootcheck(), invoked from CONFIG_BOOTCOMMAND's
# `bootcheck` gate) once this boot has stayed up for a short stable
# period -- confirms this boot succeeded so the counter doesn't creep
# toward bootlimit (default 3) during ordinary use, which would
# otherwise eventually skip bootusb and fall back straight to nandboot.
# Backgrounded + delayed (not cleared immediately) so a crash-loop
# shortly after this point in rcS still gets caught by bootcheck on the
# next boot instead of being masked. fw_setenv is a symlink to
# fw_printenv (firmware_overlay/busybox-applets.manifest); both read
# /etc/fw_env.config for the environment location.
#
# 2026-07-31: QUIETED -- U-Boot's CONFIG_ENV_IS_IN_MMC attempt was
# reverted (hung the board, see docs/DEVICE_TEST_CHECKLIST_2026-07-18.md
# §83) and it's back on CONFIG_ENV_IS_NOWHERE, meaning there is
# currently no valid environment location for fw_env.config to point
# at at all -- this line would print "Cannot parse config file:
# Invalid argument" / "Error: environment not initialized" on every
# single boot, harmlessly but noisily. Re-enable once env persistence
# gets a proper re-attempt (see that same doc section) and
# fw_env.config has a real, working entry again.
# (sleep 15 && fw_setenv bootcount 0) &

# libarkcmn.so/libarkadapt.so (vendor 2D-blit compositor + CarPlay adapter)
# hardcode /tmp/dev/memalloc as their physically-contiguous buffer-allocator
# device -- stock creates it via etc/memalloc_load.sh's `insmod .../3.4.0/
# .../memalloc.ko` + mknod. That module path doesn't exist on this kernel,
# but it doesn't need to: CONFIG_ARK_MEMALLOC=y means memalloc is built
# directly into this kernel, and mdev -s above already created the real
# device at /dev/memalloc. Just point the path the vendor libs expect at
# the real one, so full-window/submenu GPU-composited rendering (which
# depends on this device) gets a valid buffer instead of silently failing
# open() -- see docs/DEVICE_TEST_CHECKLIST_2026-07-18.md section 1b (the
# "submenus go black" investigation).
mkdir -p /tmp/dev
ln -sf /dev/memalloc /tmp/dev/memalloc

# Same story for libmfc.so's H.264/MPEG2 hardware decoder (the Hantro
# hx170dec DWL backend usr/bin/sink's VideoDecoder actually calls into for
# Android Auto video, confirmed via decompile 2026-07-24 -- contradicts an
# earlier session's wrong assumption that AA video decode never touches
# hx170dec) -- it hardcodes /tmp/dev/hx170. Real stock's own driver (a
# closed proprietary .ko, confirmed via
# "docs/logs/archived/dmesg live device kernel 3.4 dmeg_260715.txt":
# "hx170dec: module license 'Proprietary' taints kernel.") identifies as
# "hx170dec" -- our kernel's driver (drivers/soc/arkmicro/hx170dec/hx170dec.c)
# has been renamed to match (misc device name + platform driver name both
# now "hx170dec", was "vdec"/"ark-vdec" -- an unrelated open-source vendor
# SDK snapshot's own naming, confirmed NOT to match real stock, an earlier
# same-day mistake caught by comparing against the genuine stock log
# instead of another one of our own reconstructed-kernel's boot logs).
# Cross-checked independent of naming too: libmfc.so's ioctl() calls use
# magic 'k' (0x6b) with the exact HX170DEC_IOC_* command numbers this
# driver implements (drivers/soc/arkmicro/hx170dec/hx170dec.h) -- this is
# genuinely the same device/protocol. mdev creates /dev/hx170dec, never
# anything at /tmp/dev/hx170, so every H264DecInit() call failed
# immediately on open(). See docs/DEVICE_TEST_CHECKLIST_2026-07-18.md
# section 56/57.
# Same story again for libarkcmn.so's ARK_DVR_* ioctl interface (camera
# input / reverse-gear carback, drivers/soc/arkmicro/itu656/ark1668_itu656.c)
# -- it hardcodes /tmp/dev/dvr (confirmed via the "open dvr device %s
# failure." + "/tmp/dev/dvr" strings in libarkcmn.so), but the kernel
# driver's own device_create() call creates the real node at /dev/dvr, not
# /tmp/dev/dvr. Missing here the whole time -- meant arkapi_open_dvr()
# always failed at open() with ENOENT, so dvr_ioctl() was never actually
# reachable from a plain boot regardless of the CONFIG_ARK1668_ITU656/
# RN6752/ARK_CARBACK crash investigation (see docs/DEVICE_TEST_CHECKLIST_
# 2026-07-18.md item 7) -- needed for the DIAG_ITU656_* printk tags added
# there to actually fire on the next boot. Harmless dangling symlink when
# ITU656 is built disabled (the normal, non-diagnostic config).
echo "device-node compat symlinks: /dev/hx170dec (Hantro hx170dec H.264/MPEG2 hardware decoder, used by Android Auto video) -> /tmp/dev/hx170"
ln -sf /dev/hx170dec /tmp/dev/hx170
echo "device-node compat symlinks: /dev/dvr (ITU656 camera/carback ioctl interface) -> /tmp/dev/dvr"
ln -sf /dev/dvr /tmp/dev/dvr

touchdriver="/msnprofile/ark1680_ts"

# 2026-08-05: dropped the modprobe ark1680_ts/gt9xx calls that used to be
# here. ark1680_ts is built into the 4.19.192 kernel (confirmed all
# session -- it probes automatically at boot, no modprobe needed); gt9xx
# doesn't exist anywhere in this kernel tree at all, built-in or module.
# Both calls always silently no-op'd (`|| true`) regardless of which
# branch ran -- the stale "3.4.0 driver not built for 4.19.192 yet"
# comment was misleading, both had actually been resolved one way or the
# other. The symlink selection below is the only part of this block that
# still does anything real.
if [ -e $touchdriver ]; then
        ln -s   /msnprofile/touch_ark1680_ts_export /tmp/touch_export
else
        ln -s /msnprofile/touch_gt9xx_export /tmp/touch_export
fi

