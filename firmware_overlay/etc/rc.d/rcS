#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t ramfs -n none /tmp
mkdir -p /media
mount -t ramfs -n none /media
mkdir -p /var
mount -t ramfs -n none /var
mkdir -p /var/run/
mkdir -p /var/lib/lockdown
mkdir -p /var/log
sync
/sbin/mdev -s

# Persistent hotplug listener: `mdev -s` above is coldplug-only (one-shot).
# `-df` daemonizes and listens on a netlink socket for kobject uevents.
# Needs busybox 1.33.0 (CONFIG_FEATURE_MDEV_DAEMON, static-linked -- see
# tools/nss-stub/README.md and project_usb_udisk_automount memory for why
# static+nss-stub, not the old 1.30.1 dynamic build).
#
# Note: busybox's daemon mode also does its own internal coldplug scan
# before it starts listening (so it doesn't miss devices that appeared
# before its netlink socket bound) -- this means mdev.conf rules (e.g.
# usb_domount.sh) legitimately fire twice at boot, once from `-s` above
# and once from this daemon's own startup. Harmless/idempotent, kept
# rather than dropping the explicit `-s` because this daemon is
# backgrounded and not guaranteed to finish its scan before later
# synchronous steps in this script need device nodes to already exist.
/sbin/mdev -df &

# Low-latency socket busy-polling, system-wide -- AA audio-stutter
# mitigation, since sink (vendor binary) never opts in via
# SO_BUSY_POLL itself. Deliberate deviation from stock (this sysctl
# didn't exist until Linux 3.11; stock is 3.4). 50us is a generic
# starting point, not hardware-derived; revisit if CPU usage rises.
sysctl -w net.core.busy_poll=50 >/dev/null 2>&1
sysctl -w net.core.busy_read=50 >/dev/null 2>&1

# Turn on ALSA's XRUN debug logging (compiled in via
# CONFIG_SND_PCM_XRUN_DEBUG, but off by default -- needs this proc
# write per substream). 1 = one log line per XRUN. See
# project_aa_audio_stutter_investigation memory.
for f in /proc/asound/card0/pcm0p/xrun_debug /proc/asound/card0/pcm0c/xrun_debug; do
	[ -e "$f" ] && echo 1 > "$f" 2>/dev/null
done

# Set each MUSB controller's operating mode (usb1 CarPlay wired/WiFi
# role, USB-stick test-boot fast path). Run early so it can override
# the kernel's own in-progress OTG negotiation. See
# docs/WIRELESS_AND_INIT.md sec 7.
/etc/switchotg.sh

# Feed the hardware watchdog so a kernel hang triggers a real reset
# instead of the unit sitting dead. -T must match the kernel driver's
# configured timeout (ARK_WATCHDOG_DEFAULT_TIME, drivers/watchdog/
# ark_wdt.c); 5s feed / 15s timeout gives a 3x margin.
watchdog -t 5 -T 15 /dev/watchdog

# Clear U-Boot's boot-attempt counter once this boot has stayed up a
# short stable period, so it doesn't creep toward bootlimit and fall
# back to nandboot. Backgrounded+delayed so a crash-loop still gets
# caught by bootcheck on the next boot.
#
# QUIETED: U-Boot currently has no valid env location
# (CONFIG_ENV_IS_NOWHERE, see docs/DEVICE_TEST_CHECKLIST_2026-07-18.md
# §83) so this would just print harmless errors every boot. Re-enable
# once env persistence works again.
# (sleep 15 && fw_setenv bootcount 0) &

# Vendor libs hardcode buffer-allocator/decoder/DVR device paths under
# /tmp/dev/ that don't match where our kernel actually creates them
# (mdev creates the real nodes under /dev/). Symlink compat shims so
# open() succeeds instead of silently failing -- see
# docs/DEVICE_TEST_CHECKLIST_2026-07-18.md sections 1b/56/57/7.
mkdir -p /tmp/dev
ln -sf /dev/memalloc /tmp/dev/memalloc
echo "device-node compat symlinks: /dev/hx170dec (Hantro hx170dec H.264/MPEG2 hardware decoder, used by Android Auto video) -> /tmp/dev/hx170"
ln -sf /dev/hx170dec /tmp/dev/hx170
echo "device-node compat symlinks: /dev/dvr (ITU656 camera/carback ioctl interface) -> /tmp/dev/dvr"
ln -sf /dev/dvr /tmp/dev/dvr

touchdriver="/msnprofile/ark1680_ts"

# Select the right touch-export symlink for whichever touch driver is
# present. ark1680_ts is built into the kernel (no modprobe needed).
if [ -e $touchdriver ]; then
        ln -s   /msnprofile/touch_ark1680_ts_export /tmp/touch_export
else
        ln -s /msnprofile/touch_gt9xx_export /tmp/touch_export
fi

#insmod  /lib/modules/3.4.0/kernel/drivers/input/misc/pwm-beeper.ko
#insmod  /lib/modules/3.4.0/galcore.ko registerMemBase=0xE0F00000 irqLine=32 contiguousSize=0x400000 physSize=0x80000000 powerManagement=0

# Mount userdata: ext4 p3 (SD or USB, whichever root came from) first,
# NAND UBI fallback, then yaffs2. ROOTDEV comes from the kernel's own
# root= bootarg so the same rcS works for bootmmc and bootusb alike.
ROOTDEV=$(cat /proc/cmdline | sed -n 's/.*root=\([^ ]*\).*/\1/p')
USERDATADEV="${ROOTDEV%?}3"
if mount -o sync -t ext4 "$USERDATADEV" /data 2>/dev/null; then
	echo "userdata: ext4 ($USERDATADEV)"
	resetenv=$(fw_printenv factory_reset 2>/dev/null || echo "factory_reset=0")
	if [ "${resetenv##*=}" = "1" ]; then
		echo "==============Factory reset, reformat userdata!==========="
		umount /data
		mkfs.ext4 -O ^64bit,^metadata_csum -F "$USERDATADEV"
		mount -o sync -t ext4 "$USERDATADEV" /data
		fw_setenv factory_reset 0 2>/dev/null || true
	fi
else
	USERDATAFS=`cat /proc/mounts | grep ubifs`
	if [ "${USERDATAFS}" != "" ]; then
		mtd_partition=7
		resetenv=$(fw_printenv factory_reset 2>/dev/null || echo "factory_reset=0")
		if [ "${resetenv##*=}" = "1" ]; then
			echo "==============Factory reset, erase data partition!==========="
			flash_eraseall /dev/mtd$mtd_partition
			ubiattach /dev/ubi_ctrl -m $mtd_partition
			ubimkvol  /dev/ubi1 -N userdata -m 14
			ubidetach /dev/ubi_ctrl -m $mtd_partition -d 1
			fw_setenv factory_reset 0 2>/dev/null || true
		fi
		ubiattach /dev/ubi_ctrl -m $mtd_partition
		mount -o sync -t ubifs ubi1_0 /data
		if [ $? -eq 0 ]; then
			echo "userdata: NAND UBI"
		else
			sync; sleep 1
			mount -o sync -t ubifs ubi1_0 /data
			if [ $? -ne 0 ]; then
				echo "mount failed! then reformat the volume!"
				ubidetach /dev/ubi_ctrl -m $mtd_partition -d 1
				flash_eraseall /dev/mtd$mtd_partition
				ubiattach /dev/ubi_ctrl -m $mtd_partition
				ubimkvol  /dev/ubi1 -N userdata -m 14
				mount -o sync -t ubifs ubi1_0 /data
				sync
			fi
		fi
	else
		USERDATAFS=`cat /proc/mounts | grep yaffs2`
		if [ "${USERDATAFS}" != "" ]; then
			mount -t yaffs2 /dev/mtdblock6 /data/
		fi
	fi
fi
