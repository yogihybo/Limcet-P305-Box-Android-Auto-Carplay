[D-BUS Service]
Name=com.arkmicro.auto
# REMOVED 2026-08-05: the stdout/stderr redirect + `chrt -f 50` real-time
# priority wrapping this file used to have here (added 2026-07-28/2026-08-02
# during the AA audio-stutter investigation). Both were diagnostic/
# mitigation attempts that predate the actual fix, which landed
# 2026-08-05 at the kernel/driver level (DMA channel priority over eMMC,
# cyclic-DMA tasklet on HI softirq, a genuine vendor MUSB regression
# revert, and bypassing the generic dmaengine_pcm framework -- see
# linux-arkmicro commits 7e6d93657/886e8b56c/c195cb9de/3ec51480d),
# hardware-confirmed and isolation-tested to work without any userspace
# scheduling changes. `chrt -f 50` in particular was a genuine deviation
# from stock (confirmed via the real stock rootfs dump: bare
# `Exec=/usr/bin/sink`, no priority wrapping at all) that turned out to
# not be needed once the real cause was fixed -- and was directly
# implicated in a real regression of its own (RT throttling firing and
# silencing every real-time thread system-wide, see
# project_aa_audio_stutter_investigation memory). Reverted to stock's
# exact original line.
Exec=/usr/bin/sink
