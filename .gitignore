# Binary firmware images — too large for git, tracked via LFS or external storage
userdata/userdata.img
kernel/zImage
env/mtd3_env_prado_dump.bin
display/mtd4_arkdata_prado_dump.bin

# Raw NAND dumps
bootloaders/bootlogo
bootloaders/reversingtrack

# Rootfs build outputs (generated by build_rootfs.sh)
rootfs/rootfs.ubifs
rootfs/rootfs.img
rootfs/ubi.cfg

# Userdata build outputs (generated by build_userdata.sh)
userdata/userdata.ubifs
userdata/userdata.img

# Rootfs runtime pseudo-directories (empty mountpoints, no content to track)
rootfs/proc/
rootfs/sys/
rootfs/dev/
rootfs/tmp/
