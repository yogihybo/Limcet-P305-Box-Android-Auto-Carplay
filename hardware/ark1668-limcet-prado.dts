// SPDX-License-Identifier: GPL-2.0
/dts-v1/;
#include "ark1668.dtsi"
#include "ark1668-pinctrl.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Limcet P305/P306 Dashboard Head Unit";
	compatible = "arkmicro,ark1668-limcet", "arkmicro,ark1668";

	memory {
		reg = <0x0 0x8000000>; // 128MB RAM
	};

	// Reversing Signal (Mapped but Prado uses UART protocol via MCUAdapter)
	carback: carback@0 {
		compatible = "arkmicro,ark-carback";
		interrupt-parent = <&gpio0>;
		interrupts = <5 IRQ_TYPE_EDGE_BOTH>;
		detect-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
		debounce-detect = <20>;
	};

	// ARK1680 on-SoC resistive ADC touchscreen — this is the touch path
	// this unit's stock firmware actually selects (see
	// docs/boot_experiment_log.md "ROOT CAUSE FOUND" and
	// docs/ARK1680_TS_REVERSE_ENGINEERING.md), not the GT911 node below.
	tsc: tsc@e4500000 {
		compatible = "arkmicro,ark1680-ts";
		reg = <0xe4500000 0x40>;
		interrupt-parent = <&vicl>;
		interrupts = <4>;
	};

	mcu_serial: mcu-serial@0 {
		compatible = "arkmicro,ark-mcu-serial";
	};

	tool_serial: tool-serial@0 {
		compatible = "arkmicro,ark-tool-serial";
	};

	// Bit-banged I2C Bus 0 (Analog I2C)
	i2c-gpio-0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "i2c-gpio";
		gpios = <&gpio0 3 0		/* SDA (GPIO 3) */
			 &gpio0 2 0		/* SCL (GPIO 2) */
		>;
		i2c-gpio,delay-us = <6>;
		i2c-gpio,scl-output-only;

		// Richwave RN6752 AHD Camera Decoder
		dvr_rn6752: dvr_rn6752@2c {
			compatible = "arkmicro,ark1668_rn6752";
			reg = <0x2c>;
			reset-gpio = <&gpio0 0 0>;
			carback-config = <1>;
		};

		// Goodix GT911 Touchscreen Controller
		gt911: touchscreen@5d {
			compatible = "goodix,gt911";
			reg = <0x5d>;
			interrupt-parent = <&gpio0>;
			interrupts = <4 IRQ_TYPE_EDGE_FALLING>;
			irq-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			reset-gpios = <&gpio2 16 GPIO_ACTIVE_HIGH>;
			touchscreen-inverted-x;
		};
	};

	// Bit-banged I2C Bus 1
	i2c-gpio-1 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "i2c-gpio";
		gpios = <&gpio0 9 0		/* SDA (GPIO 9) */
			 &gpio3 25 0		/* SCL (GPIO 121) */
		>;
		i2c-gpio,delay-us = <6>;
		i2c-gpio,scl-output-only;

		// ROHM BD37033 Sound Processor
		// Address corrected 0x40 -> 0x41 (2026-07-13), then back to 0x40
		// (2026-07-14). The 0x41 value came only from stock's *kernel*
		// board file (i2c_board_info struct) + an i2c-scan XX marker --
		// both just prove a kernel i2c_client got registered there, not
		// that the chip answers (see docs/I2C_GPIO0_LCD_PIN_CONFLICT.md).
		// Ground truth is the vendor's own shipped userspace audio-control
		// code: disassembly of libMsnSound.so's Sound_BD37033 constructor
		// + libMsnCommons.so's arki2c_open() shows it does
		// `ioctl(fd, I2C_SLAVE, 0x80 >> 1)` = address 0x40 at runtime --
		// matching the BD37033 datasheet's public 7-bit address. This also
		// explains the persistent bd37033_write_byte timeout seen
		// throughout this investigation: the kernel-level i2c_client was
		// always misaddressed, it just never mattered because stock's real
		// control path bypasses the kernel driver entirely. See
		// docs/AUDIO_SUBSYSTEM_INVESTIGATION.md.
		amp: drv_bd37033@40 {
			status = "okay";
			compatible = "arkmicro,drv_bd37033";
			reg = <0x40>;
			flout-gain = <65>;
			frout-gain = <65>;
			rlout-gain = <65>;
			rrout-gain = <65>;
			#sound-dai-cells = <0>;
		};
	};

	// Audio Card configuration
	sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "ark1668-audio";

		// BD37033 (&amp) has no I2S DAI stream of its own -- it's
		// control-only (I2C-driven mixer controls, see
		// sound/soc/arkmicro/BD37033.c's "PA Volume" etc). Without
		// listing it as an aux-dev, its ASoC component never gets bound
		// into this card, so its controls never reach `amixer` even
		// when the I2S data path and I2C bus are both fine (found
		// 2026-07-14 via tools/audio-test/audio-test.sh -- see
		// docs/AUDIO_SUBSYSTEM_INVESTIGATION.md).
		simple-audio-card,aux-devs = <&amp>;

		// DAC/playback link listed FIRST (2026-07-13) so it lands on
		// PCM device 0, matching /etc/asound.conf's hardcoded
		// dmix slave "hw:0,0" -- simple-audio-card assigns device
		// numbers by dai-link order, and with ADC first the playback
		// device landed on hw:0,1 instead, causing every dmix/softvol
		// PCM to fail with "unable to open slave" at MsnCoreApp
		// startup (see docs/AUDIO_SUBSYSTEM_INVESTIGATION.md).
		simple-audio-card,dai-link@0 { /* I2S DAC link */
			bitclock-master = <&playback_cpu>;
			frame-master = <&playback_cpu>;
			playback_cpu: cpu {
				sound-dai = <&i2s_dac>;
			};
			playback_codec: codec {
				sound-dai = <&sddac>;
			};
		};
		simple-audio-card,dai-link@1 { /* I2S ADC link */
			cpu {
				sound-dai = <&i2s_adc>;
			};
			codec {
				sound-dai = <&sdadc>;
			};
		};
	};
};

&usb0_phy {
	compatible = "usb-nop-xceiv";
	#phy-cells = <0>;
	status = "okay";
};

&usb1_phy {
	compatible = "usb-nop-xceiv";
	#phy-cells = <0>;
	status = "okay";
};

&usb0 {
	status = "okay";
};

&usb1 {
	status = "okay";
};

// Console debug UART
&uart0 {
	use-in-kernel;
	use-for-tool;
};

&uart1 {
	status = "disabled";
};

// High-speed MCU Communication UART
&uart3 {
	use-in-kernel;
	use-for-mcu;
};

// LCD Framebuffer Configuration
&lcdc {
	display = <&display0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lcd_base &pinctrl_lcd_rgb888>;

	display0: display@0 {
		interface-type = "TTL";
		lvds-con = <0x160fd>;
		bits-per-pixel = <32>;
		power-control-gpio = <&gpio2 17 GPIO_ACTIVE_HIGH>; /* LCD power enable pin (GPIO 81) */
		lcd-wiring-mode = "BGR";
		lcdcon-backlight;
		pwms = <&pwm0 1 50000>; /* Backlight PWM Channel 1 */
		pwm-names = "backlight";
		backlight-value = <20>;
		backlight-delay = <200>;

		display-timings {
			native-mode = <&timing0>;
			timing0: timing0 {
				clock-frequency = <33000000>;
				hactive = <800>;
				vactive = <480>;
				hback-porch = <16>;
				hfront-porch = <210>;
				vback-porch = <12>;
				vfront-porch = <22>;
				hsync-len = <30>;
				vsync-len = <13>;
				hsync-active = <1>;
				vsync-active = <1>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};
	};
};

&vdec0 {
	status = "okay";
};

// SDIO WiFi Controller
&mmc1 {
	status = "okay";
	non-removable;
	broken-cd;
};

&gpu {
	compatible = "arkmicro,vivante-hal", "fsl,imx6q-gpu";
	reg-names = "iobase_3d";
	interrupt-names = "irq_3d";
	clocks = <&gpuclk>, <&gpuclk>, <&gpuclk>, <&gpuclk>, <&gpuclk>, <&gpuclk>;
	clock-names = "gpu3d_clk", "gpu3d_axi_clk", "gpu3d_shader_clk", "gpu2d_clk", "gpu2d_axi_clk", "openvg_axi_clk";
	status = "okay";
};

// DIAGNOSTIC: enabled with no child devices so both this controller and
// i2c-gpio-0 (which still owns the gt911@5d + dvr_rn6752@2c nodes above) are
// live simultaneously. Lets a userspace i2c scan on /dev/i2c-* determine,
// empirically, which physical bus the GT911 actually ACKs on — see
// docs/boot_experiment_log.md "Systematic I2C bus verification" and
// tools/i2c-scan/. Do not attach gt911 here until that scan confirms it.
&i2c0 {
	status = "okay";
	clock-frequency = <100000>;
};

&gpio0 {
	gpio-ranges = <&pinctrl0 0 0 6>, <&pinctrl0 6 6 2>, <&pinctrl0 10 10 22>;
};




