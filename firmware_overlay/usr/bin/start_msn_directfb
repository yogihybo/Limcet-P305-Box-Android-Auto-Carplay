#!/bin/sh
# Shell script to load the main MsnCoreApp on GPU-accelerated DirectFB
# (QWS_DISPLAY=directfb) -- requires the matched-version-pair galcore.ko +
# libGAL.so (see docs/DEVICE_TEST_CHECKLIST_2026-07-18.md section 1b) and
# the Vivante galcore module loaded (modprobe galcore, already done by rcS).
# Safe to run from a serial console or ssh session.
#
# See also: start_msn_linuxfb (the safe, known-working fallback backend).
# Both scripts exist so switching backends doesn't require hand-editing
# start_msn's QWS_DISPLAY block each time.

echo "Setting up environment for MsnCoreApp..."
export QTDIR=/usr/local/Qt4.7.4
export QT_PLUGIN_PATH=$QTDIR/plugins
export QT_QWS_FONTDIR=$QTDIR/lib/fonts
export LD_LIBRARY_PATH=$QTDIR/lib:/usr/lib:/lib:$LD_LIBRARY_PATH
export PATH=/bin:/sbin:/usr/bin:/usr/sbin:$QTDIR/bin:$PATH

export TS_ROOT=/usr/
export TSLIB_TSDEVICE=/dev/input/event0
export TSLIB_CONFFILE=/etc/ts.conf
export TSLIB_PLUGINDIR=/usr/lib/ts
export TSLIB_CALIBFILE=/data/pointercal
export TSLIB_CONSOLEDEVICE=none
export TSLIB_FBDEVICE=/dev/fb0

# DirectFB setup (requires Vivante galcore module loaded)
export DIRECTFB_ROOT=/usr
export DFBARGS=module-dir=$DIRECTFB_ROOT/lib/directfb-1.7-4
export QWS_DISPLAY=directfb:boundingrectflip:mmWidth220:mmHeight120:0
export GAL_CONFIG_FILE=/etc/gal_config

export QWS_KEYBOARD=TTY:/dev/tty1

# Load custom firmware setting overrides
if [ -f /msnprofile/msnexport ]; then
    source /msnprofile/msnexport
fi

# Start DBus session bus if not running
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    eval `dbus-launch --auto-syntax`
fi

echo "Starting MsnCoreApp (DirectFB/GPU)..."
exec MsnCoreApp -qws
