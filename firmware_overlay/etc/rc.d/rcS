chmod 600 /etc/ssh/ssh_host_*_key
mkdir -p /var/run/sshd
mkdir -p /var/empty
chmod 755 /var/empty
/usr/bin/sshd -f /etc/ssh/sshd_config &

# Load GPU driver. registerMemBase/irqLine are required -- the DT node
# is disabled/unmatched, so galcore only binds via the legacy
# drv_init() module-param path; without these it defaults to the
# wrong register base and irqLine=-1. contiguousSize=0x800000 matches
# stock's real (etc/profile) insmod line -- see
# docs/DEVICE_TEST_CHECKLIST_2026-07-18.md section 21/22.
modprobe galcore registerMemBase=0xE0F00000 irqLine=32 contiguousSize=0x800000 physSize=0x80000000 powerManagement=0

# Load USB WiFi driver. rtw_drv_log_level=2 keeps real errors visible
# while dropping routine chatter. rtw_country_code=US avoids the
# driver's WORLDWIDE regulatory fallback (no 5GHz), which broke
# wireless CarPlay/AA hostapd setup -- see
# project_wireless_carplay_aa_channel_plan memory. cfg80211 is loaded
# explicitly first since relying on rtl8811cu's own dependency chase
# raced it (observed failing twice on real boots before succeeding).
modprobe cfg80211
modprobe rtl8811cu rtw_drv_log_level=2 rtw_country_code=US

# Set up DHCP lease directory and file
mkdir -p /data
touch /data/udhcpd.leases

# Static-SSID AP (etc/wifi_ap.sh) disabled: sink generates its own
# per-connection dynamic AP, and a static one already bound to wlan0
# blocks that -- see project_static_wifi_ap_vs_dynamic memory. STA
# mode still available by hand via etc/wifi_client.sh.
#/etc/wifi_ap.sh &
#/etc/wifi_client.sh &

# Auto-start MsnCoreApp (main UI) at boot. Sources /etc/profile first
# in the same subshell -- launching without it races a real GPU-driver
# page fault (missing CARPLAY_*/touch env vars that only /etc/profile
# sets), hardware-confirmed fixed 2026-08-03. 1s delay is a margin for
# /etc/profile's own dependencies, not GPU-related.
(sleep 1 && . /etc/profile && /usr/bin/start_msn_directfb) &

